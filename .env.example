# Copie ce fichier en .env et remplis les valeurs. Ne commite jamais .env.
# Chaque variable utilisée par l'app doit apparaître ici (sans vraie valeur).
# Sur Vercel : Settings → Environment Variables (Production et Preview).

# Supabase : Project Settings → API Keys. Valeurs publiques, protégées par les règles RLS.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
