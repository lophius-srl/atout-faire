{
  "name": "atout-faire",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check . && pnpm run check",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write . && eslint . --fix",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@sveltejs/adapter-vercel": "^5.10.0",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "eslint": "9.39.1",
    "eslint-plugin-svelte": "^3.11.0",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
